---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Exercises">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <h1 class="text-3xl font-bold text-white">Exercises</h1>
      <button
        hx-get="/exercises/new"
        hx-target="#modal-container"
        hx-swap="innerHTML"
        hx-on:click="if(!this.classList.contains('htmx-request')){document.getElementById('modal-container').classList.add('active')}"
        class="bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2 rounded-lg font-medium transition"
      >
        + New Exercise
      </button>
    </div>

    <!-- Exercise Library -->
    <div class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden">
      <div class="p-6 border-b border-gray-800">
        <h2 class="text-xl font-semibold text-white">Exercise Library</h2>
      </div>
      <div
        id="exercise-list"
        hx-get="/exercises/html/"
        hx-trigger="load"
        hx-swap="innerHTML"
        class="p-6 space-y-3"
      >
        <p class="text-gray-400">Loading exercises...</p>
      </div>
    </div>

    <!-- Modal Container -->
    <div
      id="modal-container"
      onclick="if(event.target === this){this.innerHTML = '';this.classList.remove('active')}"
    ></div>
  </div>
</Layout>
