---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Analytics">
  <div class="space-y-6">
    <h1 class="text-3xl font-bold text-white">Analytics</h1>

    <!-- Analytics Summary -->
    <div
      id="analytics-summary"
      hx-get="/analytics/summary"
      hx-trigger="load"
      hx-swap="innerHTML"
      class="bg-gray-900 border border-gray-800 rounded-xl p-6"
    >
      <p class="text-gray-400">Loading analytics...</p>
    </div>

    <!-- Volume Chart Placeholder -->
    <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
      <h2 class="text-xl font-semibold text-white mb-4">Volume Over Time</h2>
      <div class="h-64 flex items-center justify-center text-gray-500 border-2 border-dashed border-gray-700 rounded-lg">
        <p>Chart renders here — connect to /analytics/volume</p>
      </div>
    </div>

    <!-- Progression Chart Placeholder -->
    <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
      <h2 class="text-xl font-semibold text-white mb-4">Strength Progression</h2>
      <div class="h-64 flex items-center justify-center text-gray-500 border-2 border-dashed border-gray-700 rounded-lg">
        <p>Chart renders here — connect to /analytics/progression</p>
      </div>
    </div>
  </div>
</Layout>
