---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dashboard">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <h1 class="text-3xl font-bold text-white">Dashboard</h1>
      <a href="/workouts" class="bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-2 rounded-lg font-medium transition">
        + New Workout
      </a>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
        <div class="text-gray-400 text-sm font-medium mb-1">Total Workouts</div>
        <div class="text-4xl font-bold text-white" id="stat-workouts">—</div>
        <div hx-get="http://localhost:8000/workouts/" hx-trigger="load" hx-swap="innerHTML" hx-target="#stat-workouts" hx-on::htmx-after-request="this.innerText = '0'" class="text-emerald-400 text-sm mt-2"></div>
      </div>

      <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
        <div class="text-gray-400 text-sm font-medium mb-1">Total Exercises</div>
        <div class="text-4xl font-bold text-white" id="stat-exercises">—</div>
        <div hx-get="http://localhost:8000/exercises/" hx-trigger="load" hx-swap="innerHTML" hx-target="#stat-exercises" hx-on::htmx-after-request="this.innerText = '0'" class="text-emerald-400 text-sm mt-2"></div>
      </div>

      <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
        <div class="text-gray-400 text-sm font-medium mb-1">This Week</div>
        <div class="text-4xl font-bold text-white">—</div>
        <div class="text-emerald-400 text-sm mt-2">Keep it up!</div>
      </div>
    </div>

    <!-- Recent Activity -->
    <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
      <h2 class="text-xl font-semibold text-white mb-4">Recent Workouts</h2>
      <div
        hx-get="http://localhost:8000/workouts/"
        hx-trigger="load"
        hx-swap="innerHTML"
        class="text-gray-400"
      >
        <p>Loading recent workouts...</p>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <a href="/workouts" class="bg-gray-900 border border-gray-800 rounded-xl p-6 hover:border-emerald-500 transition group">
        <h3 class="text-lg font-semibold text-white group-hover:text-emerald-400 transition">🏋️ Log Workout</h3>
        <p class="text-gray-400 text-sm mt-1">Record your sets, reps, and weights</p>
      </a>

      <a href="/analytics" class="bg-gray-900 border border-gray-800 rounded-xl p-6 hover:border-emerald-500 transition group">
        <h3 class="text-lg font-semibold text-white group-hover:text-emerald-400 transition">📊 View Analytics</h3>
        <p class="text-gray-400 text-sm mt-1">Track your progress over time</p>
      </a>
    </div>
  </div>
</Layout>
