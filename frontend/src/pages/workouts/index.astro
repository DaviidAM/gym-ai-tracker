---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Workouts">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <h1 class="text-3xl font-bold text-white">Workouts</h1>
      <button
        hx-get="http://localhost:8000/workouts/new"
        hx-target="#modal-container"
        hx-swap="innerHTML"
        class="bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-2 rounded-lg font-medium transition"
      >
        + New Workout
      </button>
    </div>

    <!-- Workout List -->
    <div class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden">
      <div class="p-6 border-b border-gray-800">
        <h2 class="text-xl font-semibold text-white">All Workouts</h2>
      </div>
      <div
        id="workout-list"
        hx-get="http://localhost:8000/workouts/"
        hx-trigger="load"
        hx-swap="innerHTML"
        class="p-6"
      >
        <p class="text-gray-400">Loading workouts...</p>
      </div>
    </div>

    <!-- Modal Container -->
    <div id="modal-container"></div>
  </div>
</Layout>
